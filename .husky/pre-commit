#!/usr/bin/env bash

echo "🔍 Checking TypeScript and lint errors..."

# 1. TypeScript - block on errors
(cd frontend && npx tsc --noEmit) || exit 1
(cd backend && npx tsc --noEmit) || exit 1

# 2. ESLint - block only on errors (quiet hides warnings)
(cd frontend && npx eslint . --ext .ts,.tsx --quiet) || exit 1
(cd backend && npx eslint . --ext .ts,.tsx --quiet) || exit 1

echo "✅ Lint passed! Formatting staged files..."

# 3. Format only staged files with Prettier
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|css|scss|md)$')

if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs npx prettier --write

  # Re-add formatted files to git
  echo "$STAGED_FILES" | xargs git add
fi

echo "✅ All checks and formatting done!"
