generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Platform Admin Users
model Platform_admins {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  name              String
  role_id           String?
  image             String?
  is_active         Boolean             @default(true)
  last_login        DateTime?
  created_by        String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  deleted_at        DateTime?
  role              Platform_roles?     @relation(fields: [role_id], references: [id], onDelete: SetNull)
  created_by_admin  Platform_admins?    @relation("AdminCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  created_admins    Platform_admins[]   @relation("AdminCreatedBy")
  created_tenants   Tenants[]           @relation("TenantCreatedBy")
  created_plans     Plans[]             @relation("PlanCreatedBy")
  reviewed_requests Tenant_requests[]   @relation("RequestReviewedBy")
  
  @@map("platform_admins")
}

// Platform Password Reset OTP
model Platform_reset_password {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("platform_reset_password")
}

// Platform Roles
model Platform_roles {
  id                  String                     @id @default(uuid())
  name                String                     @unique
  description         String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  admins              Platform_admins[]
  role_permissions    Platform_role_permissions[]

  @@map("platform_roles")
}

// Platform Modules
model Platform_modules {
  id          String                     @id @default(uuid())
  name        String                     @unique
  description String?
  created_at  DateTime                   @default(now())
  updated_at  DateTime                   @updatedAt
  permissions Platform_role_permissions[]

  @@map("platform_modules")
}

// Platform Role Permissions
model Platform_role_permissions {
  id        String           @id @default(uuid())
  role_id   String
  module_id String
  can_read  Boolean          @default(false)
  can_edit  Boolean          @default(false)
  role      Platform_roles   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  module    Platform_modules @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module_id])
  @@index([role_id])
  @@map("platform_role_permissions")
}

// Subscription Plans
model Plans {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  price       Float               @default(0)
  limits      Json                // { candidates: 100, assessments: 50, storage_gb: 10 }
  features    Json                // { custom_branding: true, api_access: false }
  is_active   Boolean             @default(true)
  created_by  String?
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  tenants     Tenants[]
  tenant_requests Tenant_requests[]
  created_by_admin Platform_admins? @relation("PlanCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@map("plans")
}

// Tenants (Organizations)
model Tenants {
  id                   String              @id @default(uuid())
  name                 String
  slug                 String              @unique // subdomain
  status               TenantStatus        @default(active)
  plan_id              String
  db_name              String              @unique
  db_url               String              // Connection string for tenant DB
  admin_email          String
  admin_name           String
  subscription_starts_at DateTime?
  subscription_ends_at DateTime?
  created_by           String?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  deleted_at           DateTime?
  plan                 Plans               @relation(fields: [plan_id], references: [id])
  usage                Tenant_usage[]
  usage_events         Usage_event[]
  tenant_requests      Tenant_requests[]
  created_by_admin     Platform_admins?    @relation("TenantCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@map("tenants")
}  

// Tenant Usage Tracking
model Tenant_usage {
  id            String   @id @default(uuid())
  tenant_id     String
  metric_type   UsageMetric
  current_value Int      @default(0)
  limit_value   Int
  period_start  DateTime
  period_end    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  tenant        Tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, metric_type, period_start])
  @@index([tenant_id])
  @@map("tenant_usage")
}
 model Usage_event {
  id            String  @id @default(uuid())
  tenant_id     String
  metric_type   UsageMetric
  event_value   Int
  created_at    DateTime @default(now())
  tenant        Tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  
  @@index([metric_type])
  @@index([created_at])
  @@index([tenant_id, metric_type, created_at])
  @@map("usage_events")
 }
// Tenant Requests
model Tenant_requests {
  id                 String   @id @default(uuid())
  organization_name  String
  slug               String   @unique
  admin_name         String
  admin_email        String   @unique
  admin_password     String
  requested_plan_id  String?
  status             TenantRequestStatus @default(pending)
  reviewed_by        String?
  reviewed_at        DateTime?
  rejection_reason   String?
  tenant_id          String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  requested_plan     Plans?           @relation(fields: [requested_plan_id], references: [id], onDelete: SetNull)
  reviewed_admin     Platform_admins? @relation("RequestReviewedBy", fields: [reviewed_by], references: [id], onDelete: SetNull)
  tenant             Tenants?         @relation(fields: [tenant_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([admin_email])
  @@index([slug])
  @@map("tenant_requests")
}

// Enums
enum TenantStatus {
  active
  suspended
  trial
  expired
  cancelled
}

enum UsageMetric {
  candidates
  assessments
  questions
}

enum TenantRequestStatus {
  pending
  processing
  approved
  rejected
}
