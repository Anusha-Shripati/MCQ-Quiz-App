# JWT Configs
ACCESS_SECRET="access@secret"
ACCESS_EXPIRES="1d"
REFRESH_SECRET="referesh@secret"
REFRESH_EXPIRES="7d"

# Redis
REDIS_HOST="redis-container" # Use the container name
REDIS_PORT=6379
SUPER_ADMIN_PASSWORD=superadminpassword

# Platform Database (SaaS Management)
DATABASE_URL="postgresql://postgres:root@localhost:5432/platform_db"

# Tenant Database (Default for development)
TENANT_DB_URL="postgresql://postgres:root@localhost:5432/app_db"

# Development tenant slug (for localhost testing)
DEV_TENANT_SLUG="localhost"

# Base domain for multi-tenancy (strict validation)
BASE_DOMAIN="lr-mcq.local"
