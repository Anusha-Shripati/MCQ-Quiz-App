generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id              String        @id @default(uuid())
    role_id         String?
    name            String        
    email           String        @unique
    password        String
    token           String?
    created_at      DateTime      @default(now())
    updated_at      DateTime      @updatedAt
    deleted_at      DateTime?
    role            Roles?        @relation(fields: [role_id], references: [id], name: "UserRole", onDelete: SetNull)
    image           String?
    created_by      String?
    assessments     Assessments[]
    questions       Questions[]
    exams           Exam[]
    Candidate       Candidate[]
    childs          User[]        @relation("User")
    created_by_user User?         @relation("User", fields: [created_by], references: [id])
    User_tokens     User_tokens[]

    @@map("users")
}

model Reset_password {
    id         String   @id @default(uuid())
    email      String   @unique
    otp        String
    expires_at DateTime
    created_at DateTime @default(now())

    @@map("password_resets")
}

model Roles {
    id               String             @id @default(uuid())
    name             String             @unique
    users            User[]             @relation("UserRole")
    role_permissions Role_permissions[]
}

model Modules {
    id          String             @id @default(uuid())
    name        String             @unique
    permissions Role_permissions[]
}

model Role_permissions {
    id        String  @id @default(uuid())
    role_id   String
    role      Roles   @relation(fields: [role_id], references: [id])
    module_id String
    module    Modules @relation(fields: [module_id], references: [id])
    can_read  Boolean @default(false)
    can_edit  Boolean @default(false)

    @@index([role_id])
}

model Assessments {
    id               String                  @id @default(uuid())
    name             String
    created_by       String
    easy             Int                     @default(0)
    medium           Int                     @default(0)
    hard             Int                     @default(0)
    difficulty_score Int                     @default(0)
    duration         Int                     @default(0)
    pass_criteria    Int                     @default(0)
    created_at       DateTime                @default(now())
    updated_at       DateTime                @updatedAt
    deleted_at       DateTime?
    technologies     Assessment_technology[]
    created_by_user  User                    @relation(fields: [created_by], references: [id])
    candidates       Candidate[]
    exams            Exam[]
}

model Assessment_technology {
    id            String      @id @default(uuid())
    technology_id String
    assessment_id String
    easy          Json
    medium        Json
    hard          Json
    assessments   Assessments @relation(fields: [assessment_id], references: [id])
    technology    Technology  @relation(fields: [technology_id], references: [id])
    created_at    DateTime    @default(now())
    updated_at    DateTime    @updatedAt
    deleted_at    DateTime?
}

model Technology {
    id                    String                  @id @default(uuid())
    name                  String                  @unique
    created_at            DateTime                @default(now())
    updated_at            DateTime                @updatedAt
    deleted_at            DateTime?
    assessment_technology Assessment_technology[]
    questions             Questions[]
}

model Questions {
    id               String           @id @default(uuid())
    technology_id    String
    question         String
    correct_answer   String[]
    options          Json
    time             String?
    difficulty_level Difficulty
    type             Question_type
    meta             Json
    created_at       DateTime         @default(now())
    updated_at       DateTime         @updatedAt
    deleted_at       DateTime?
    created_by       String
    technology       Technology       @relation(fields: [technology_id], references: [id])
    exam_questions   Exam_questions[]
    answers          Answers[]
    created_by_user  User             @relation(fields: [created_by], references: [id])
}

model Candidate {
    id              String               @id @default(uuid())
    assessment_id   String
    exam_id         String               @unique
    name            String
    email           String
    experience      Float                @default(0)
    phone           String
    meta            Json?
    created_at      DateTime             @default(now())
    updated_at      DateTime             @updatedAt
    deleted_at      DateTime?
    created_by      String
    assessment      Assessments          @relation(fields: [assessment_id], references: [id])
    exam            Exam                 @relation(fields: [exam_id], references: [id])
    answers         Answers[]
    result          Results[]
    feedback        Candidate_feedback[]
    created_by_user User                 @relation(fields: [created_by], references: [id])
}

model Exam {
    id             String               @id @default(uuid())
    user_id        String
    assessment_id  String
    end_time       DateTime
    start_time     DateTime
    status         ExamStatus           @default(pending)
    is_completed   Boolean              @default(false)
    meta           Json?
    verified_image String?
    created_at     DateTime             @default(now())
    updated_at     DateTime             @updatedAt
    deleted_at     DateTime?
    user           User                 @relation(fields: [user_id], references: [id])
    assessment     Assessments          @relation(fields: [assessment_id], references: [id])
    exam_questions Exam_questions[]
    answers        Answers[]
    candidate      Candidate?
    results        Results?
    feedback       Candidate_feedback[]
}

model Exam_questions {
    id          String    @id @default(uuid())
    exam_id     String
    question_id String
    exam        Exam      @relation(fields: [exam_id], references: [id])
    question    Questions @relation(fields: [question_id], references: [id])
}

model Results {
    id           String @id @default(uuid())
    exam_id      String @unique
    candidate_id String
    score        Float  @default(0)
    total        Float  @default(0)
    percentage   Float  @default(0)

    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?
    exam       Exam      @relation(fields: [exam_id], references: [id])
    candidate  Candidate @relation(fields: [candidate_id], references: [id])
    answers    Answers[]
}

model Answers {
    id            String   @id @default(uuid())
    exam_id       String
    candidate_id  String
    question_id   String?
    result_id     String?
    user_answer   String[]
    is_correct    Boolean?
    question_name String?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt
    score         Float    @default(0)
    weight        Float    @default(0)

    exam      Exam       @relation(fields: [exam_id], references: [id])
    candidate Candidate  @relation(fields: [candidate_id], references: [id])
    question  Questions? @relation(fields: [question_id], references: [id])
    result    Results?   @relation(fields: [result_id], references: [id])
}

model User_tokens {
    id      String  @id @default(uuid())
    user_id String?
    token   String
    user    User?    @relation(fields: [user_id], references: [id])
}

model Candidate_feedback {
    id                String    @id @default(uuid())
    candidate_id      String
    exam_id           String
    experience_rating Int
    question_clarity  String
    difficulty        String
    technical_issues  String
    comments          String?
    created_at        DateTime  @default(now())
    updated_at        DateTime  @updatedAt
    deleted_at        DateTime?
    
    candidate         Candidate @relation(fields: [candidate_id], references: [id])
    exam              Exam      @relation(fields: [exam_id], references: [id])
}

