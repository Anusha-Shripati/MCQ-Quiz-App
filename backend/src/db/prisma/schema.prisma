enum Role {
    Super_Admin
    Editor
    Candidate
}

enum ExamStatus {
    pending
    in_progress
    completed
    expired
}

enum Difficulty {
    easy
    medium
    hard
}

enum Question_type {
    multiple_select
    video
    text
    mcq
    code_snippet
    code_editor
    code_snippet_with_mcq
}
