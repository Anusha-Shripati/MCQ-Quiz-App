enum Role {
    Super_Admin
    Editor
    Candidate
}

enum ExamStatus {
    passed
    failed
    in_progress
}

enum Difficulty {
    easy
    medium
    hard
}

enum Question_type {
    multiple_select
    video
    text
    mcq
}
