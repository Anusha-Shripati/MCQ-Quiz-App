enum Role {
    Super_Admin
    Editor
    Candidate
}

enum ExamStatus {
    pending
    in_progress
    completed
}

enum Difficulty {
    easy
    medium
    hard
}

enum Question_type {
    multiple_select
    video
    text
    mcq
    code_snippet
}
